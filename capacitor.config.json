{
  "appId": "com.mutoe.taiwanstocklab",
  "appName": "Taiwan Stock Lab",
  "webDir": "web",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "FirebaseAuthentication": {
      "providers": [
        "google.com"
      ],
      "skipNativeAuth": true
    }
  }
}
